# PartyKit host: localhost:1999 in dev, planary-blackjack.<user>.partykit.dev in production
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
# Same Supabase project as planary-auth (optional: without it everyone plays as a guest)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.planary.ch
NEXT_PUBLIC_CASINO_URL=https://casino.planary.ch
# PartyKit server env (set with `npx partykit env add`): SUPABASE_URL, SUPABASE_ANON_KEY
